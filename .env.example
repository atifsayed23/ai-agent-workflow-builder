# Nhost Project Settings
NEXT_PUBLIC_NHOST_SUBDOMAIN=local
NEXT_PUBLIC_NHOST_REGION=us-east-1

# PostgreSQL Database URL (Nhost or External Postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nhost
NHOST_POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/nhost

# Hasura GraphQL Engine Endpoint
NEXT_PUBLIC_HASURA_GRAPHQL_URL=http://localhost:8080/v1/graphql
ACTION_BASE_URL=http://localhost:3000

# Google Gemini LLM API Key (Optional - uses mock AI fallback engine with delay if unset)
GEMINI_API_KEY=your_gemini_api_key_here
